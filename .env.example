# Environment-specific settings. Copy to .env (gitignored), fill in, then run tools/install_hooks.sh.
# One KEY=VALUE per line; quote values that contain spaces. Values already set in the real environment win.
# Nothing from the real .env may be committed: tools/check_leaks.py (pre-commit and pre-push hooks) blocks it.

# kubectl context of the AKS cluster, used by tools/*.sh and the local CLI. The in-cluster controller uses its
# service account instead (its image sets HILLCLIMB_KUBE_CONTEXT="").
HILLCLIMB_KUBE_CONTEXT=my-aks-context

# The GPU nodes used as trial lanes (kubectl get nodes). The controller runs on lane n0's node, where its ledger
# lives on the local NVMe.
HILLCLIMB_LANES=n0=aks-gpu-00000000-vmss000000,n1=aks-gpu-00000000-vmss000001

# Registry with the controller image and mirrored engine images (vllm/vllm-openai, lmsysorg/sglang,
# nvidia/k8s-device-plugin). The deploy manifests require it; if it is empty, trials pull engine images from
# Docker Hub.
HILLCLIMB_REGISTRY=myregistry.azurecr.io

# Azure Container Registry name and its subscription, used by `az acr build` in tools/deploy.sh.
HILLCLIMB_ACR_NAME=myregistry
HILLCLIMB_AZ_SUBSCRIPTION=00000000-0000-0000-0000-000000000000

# Other private strings the leak check must never find in tracked files, commit messages or history,
# comma-separated: aliases, people's names, subscription and resource-group names, local paths.
HILLCLIMB_PRIVATE_TERMS="my-alias,My Subscription Name,my-resource-group,/home/my-user"
